  <script is:inline>
    // Force scroll to top after DOM paint (catches Vite HMR scroll restore)
    requestAnimationFrame(function() { window.scrollTo(0, 0); });

    // Smooth-scroll nav links without persisting hash in URL
    document.querySelectorAll('a[data-scroll]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = link.getAttribute('href').slice(1);
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // Close mobile menu if open
          document.getElementById('nav-links')?.classList.remove('nav-open');
          document.getElementById('hamburger')?.classList.remove('hamburger-open');
        }
      });
    });

    // Mobile hamburger
    document.getElementById('hamburger')?.addEventListener('click', () => {
      document.getElementById('nav-links')?.classList.toggle('nav-open');
      document.getElementById('hamburger')?.classList.toggle('hamburger-open');
    });

    // Provider tabs
    document.querySelectorAll('.install-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        document.querySelectorAll('.install-tab').forEach(t => t.dataset.active = 'false');
        document.querySelectorAll('.install-panel').forEach(p => p.dataset.active = 'false');
        tab.dataset.active = 'true';
        document.querySelector(`[data-panel="${target}"]`).dataset.active = 'true';
      });
    });

    // Copy buttons
    document.querySelectorAll('.install-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        const panel = btn.closest('.install-panel');
        const code = panel.querySelector('code').textContent;
        navigator.clipboard.writeText(code).then(() => {
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
        });
      });
    });

    // Animate benchmark bars on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    document.querySelectorAll('.benchmark').forEach(el => observer.observe(el));

    // Animate streaming bar
    const streamObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate');
          streamObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.bento-visual-streaming').forEach(el => streamObserver.observe(el));
  </script>


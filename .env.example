# Sairo — Environment Variables
# Copy this file to .env and fill in your values

# S3 Configuration (required)
S3_ENDPOINT=https://your-s3-endpoint.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# Authentication
ADMIN_USER=admin
ADMIN_PASS=choose-a-strong-password
JWT_SECRET=run-openssl-rand-hex-32-to-generate
SESSION_HOURS=24

# Deployment
SECURE_COOKIE=false          # Set to "true" when behind HTTPS
RECRAWL_INTERVAL=120         # Seconds between automatic re-index cycles
DB_DIR=/data                 # Directory for SQLite databases

# LDAP (optional)
# LDAP_ENABLED=true
# LDAP_SERVER=ldaps://ldap.example.com
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_BIND_DN=cn=service,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_ADMIN_GROUP=CN=Admins,OU=Groups,DC=example,DC=com
# LDAP_DEFAULT_ROLE=viewer

# OAuth / OIDC (optional)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_DEFAULT_ROLE=viewer
# OAUTH_ALLOWED_DOMAINS=example.com

# White-labeling (optional)
# APP_NAME=Sairo
# PRIMARY_COLOR=#3b82f6
# LOGIN_MESSAGE=Welcome to our storage portal
